<.flash_group flash={@flash} />

<div class="relative min-h-screen bg-gray-50">
  <main class="py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header with create button and filters -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <h1 class="text-2xl font-semibold text-gray-900">Active Teams</h1>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <div class="flex space-x-2 w-full sm:w-auto">
            <select class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              <option>All Regions</option>
              <option>North America</option>
              <option>Europe</option>
              <option>Asia</option>
              <option>Oceania</option>
              <option>South America</option>
            </select>
            
            <select class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              <option>All Ranks</option>
              <option>Silver</option>
              <option>Gold Nova</option>
              <option>Master Guardian</option>
              <option>Legendary Eagle+</option>
            </select>
          </div>
          
          <a href={~p"/teamfinder/create"} class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Create Lobby
          </a>
        </div>
      </div>
      
      <!-- Main content - Teams listing in Discord style -->
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3">
          <!-- Left sidebar - Categories -->
          <div class="bg-gray-800 lg:block">
            <div class="p-4 border-b border-gray-700">
              <h2 class="text-lg font-medium text-white">Lobby Types</h2>
            </div>
            <div class="py-2">
              <button class="w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left">
                <span class="h-2 w-2 bg-green-400 rounded-full mr-2"></span>
                <span>Competitive (12)</span>
              </button>
              <button class="w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left">
                <span class="h-2 w-2 bg-blue-400 rounded-full mr-2"></span>
                <span>Casual (8)</span>
              </button>
              <button class="w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left">
                <span class="h-2 w-2 bg-purple-400 rounded-full mr-2"></span>
                <span>Practice/Scrims (5)</span>
              </button>
              <button class="w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left">
                <span class="h-2 w-2 bg-yellow-400 rounded-full mr-2"></span>
                <span>Tournament (2)</span>
              </button>
            </div>
          </div>
          
          <!-- Middle - Lobby listing -->
          <div class="border-r border-gray-200 lg:col-span-2">
            <div class="p-4 border-b border-gray-200 bg-gray-50">
              <div class="relative">
                <input type="text" placeholder="Search lobbies..." class="block w-full rounded-md border-gray-300 pr-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Lobby Cards -->
            <div class="p-4 space-y-4 max-h-[calc(100vh-12rem)] overflow-y-auto">
              <!-- Lobby 1 -->
              <div class="border border-gray-200 rounded-lg hover:border-indigo-500 transition-colors duration-150">
                <div class="flex p-4 items-center justify-between border-b border-gray-200">
                  <div class="flex items-center">
                    <span class="h-3 w-3 bg-green-400 rounded-full mr-3"></span>
                    <h3 class="text-lg font-medium text-gray-900">Team Alpha - Looking for 2</h3>
                  </div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Competitive
                  </span>
                </div>
                
                <div class="p-4">
                  <div class="flex justify-between mb-3">
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Region:</span> North America
                    </div>
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Rank:</span> Master Guardian+
                    </div>
                  </div>
                  
                  <div class="border-t border-gray-200 pt-3 pb-1">
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Current Players (3/5):</h4>
                    <div class="flex flex-wrap gap-2">
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-indigo-500 flex items-center justify-center text-white text-xs mr-2">JD</div>
                        <span class="text-sm">JohnDoe</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-pink-500 flex items-center justify-center text-white text-xs mr-2">AS</div>
                        <span class="text-sm">AimStar</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-green-500 flex items-center justify-center text-white text-xs mr-2">FZ</div>
                        <span class="text-sm">FrazerGG</span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="bg-gray-50 px-4 py-3 rounded-b-lg flex justify-between items-center">
                  <span class="text-xs text-gray-500">Created 10 minutes ago</span>
                  <a href={~p"/teamfinder/1"} class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    View Details
                  </a>
                </div>
              </div>
              
              <!-- Lobby 2 -->
              <div class="border border-gray-200 rounded-lg hover:border-indigo-500 transition-colors duration-150">
                <div class="flex p-4 items-center justify-between border-b border-gray-200">
                  <div class="flex items-center">
                    <span class="h-3 w-3 bg-blue-400 rounded-full mr-3"></span>
                    <h3 class="text-lg font-medium text-gray-900">Casual Squad - Open Lobby</h3>
                  </div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Casual
                  </span>
                </div>
                
                <div class="p-4">
                  <div class="flex justify-between mb-3">
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Region:</span> Europe
                    </div>
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Rank:</span> Any Rank
                    </div>
                  </div>
                  
                  <div class="border-t border-gray-200 pt-3 pb-1">
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Current Players (4/5):</h4>
                    <div class="flex flex-wrap gap-2">
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-orange-500 flex items-center justify-center text-white text-xs mr-2">MK</div>
                        <span class="text-sm">MaxKill</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-purple-500 flex items-center justify-center text-white text-xs mr-2">LS</div>
                        <span class="text-sm">LuckyShot</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-yellow-500 flex items-center justify-center text-white text-xs mr-2">N8</div>
                        <span class="text-sm">Nate88</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-cyan-500 flex items-center justify-center text-white text-xs mr-2">WL</div>
                        <span class="text-sm">WildLife</span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="bg-gray-50 px-4 py-3 rounded-b-lg flex justify-between items-center">
                  <span class="text-xs text-gray-500">Created 25 minutes ago</span>
                  <a href={~p"/teamfinder/2"} class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    View Details
                  </a>
                </div>
              </div>
              
              <!-- Lobby 3 -->
              <div class="border border-gray-200 rounded-lg hover:border-indigo-500 transition-colors duration-150">
                <div class="flex p-4 items-center justify-between border-b border-gray-200">
                  <div class="flex items-center">
                    <span class="h-3 w-3 bg-purple-400 rounded-full mr-3"></span>
                    <h3 class="text-lg font-medium text-gray-900">Practice Team - Need 3</h3>
                  </div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    Practice
                  </span>
                </div>
                
                <div class="p-4">
                  <div class="flex justify-between mb-3">
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Region:</span> Asia
                    </div>
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Rank:</span> Gold Nova+
                    </div>
                  </div>
                  
                  <div class="border-t border-gray-200 pt-3 pb-1">
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Current Players (2/5):</h4>
                    <div class="flex flex-wrap gap-2">
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-red-500 flex items-center justify-center text-white text-xs mr-2">CS</div>
                        <span class="text-sm">CSMaster</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs mr-2">RS</div>
                        <span class="text-sm">RushSniper</span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="bg-gray-50 px-4 py-3 rounded-b-lg flex justify-between items-center">
                  <span class="text-xs text-gray-500">Created 1 hour ago</span>
                  <a href={~p"/teamfinder/3"} class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    View Details
                  </a>
                </div>
              </div>
              
              <!-- Lobby 4 -->
              <div class="border border-gray-200 rounded-lg hover:border-indigo-500 transition-colors duration-150">
                <div class="flex p-4 items-center justify-between border-b border-gray-200">
                  <div class="flex items-center">
                    <span class="h-3 w-3 bg-yellow-400 rounded-full mr-3"></span>
                    <h3 class="text-lg font-medium text-gray-900">Tournament Team - Full</h3>
                  </div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Tournament
                  </span>
                </div>
                
                <div class="p-4">
                  <div class="flex justify-between mb-3">
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Region:</span> North America
                    </div>
                    <div class="text-sm text-gray-500">
                      <span class="font-medium text-gray-900">Rank:</span> Legendary Eagle+
                    </div>
                  </div>
                  
                  <div class="border-t border-gray-200 pt-3 pb-1">
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Current Players (5/5):</h4>
                    <div class="flex flex-wrap gap-2">
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-emerald-500 flex items-center justify-center text-white text-xs mr-2">PX</div>
                        <span class="text-sm">PhoenixPro</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-sky-500 flex items-center justify-center text-white text-xs mr-2">VG</div>
                        <span class="text-sm">VanguardOps</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-amber-500 flex items-center justify-center text-white text-xs mr-2">HT</div>
                        <span class="text-sm">HeadTap</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-violet-500 flex items-center justify-center text-white text-xs mr-2">SR</div>
                        <span class="text-sm">SniperRex</span>
                      </div>
                      <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                        <div class="h-6 w-6 rounded-full bg-rose-500 flex items-center justify-center text-white text-xs mr-2">GL</div>
                        <span class="text-sm">GlobalElite</span>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="bg-gray-50 px-4 py-3 rounded-b-lg flex justify-between items-center">
                  <span class="text-xs text-gray-500">Created 3 hours ago</span>
                  <a href={~p"/teamfinder/4"} class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    View Details
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div> 