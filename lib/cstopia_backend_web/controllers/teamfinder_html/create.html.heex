<.flash_group flash={@flash} />

<div class="relative min-h-screen bg-gray-50">
  <main class="py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="bg-white shadow overflow-hidden sm:rounded-lg p-6">
        <div class="flex items-center justify-between mb-8">
          <h1 class="text-2xl font-semibold text-gray-900">Create Team Listing</h1>
          <a href={~p"/teamfinder"} class="text-indigo-600 hover:text-indigo-800">Back to Team Finder</a>
        </div>

        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Listing Title</label>
              <input type="text" name="title" id="title" placeholder="Enter a descriptive title" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" />
            </div>
            
            <div>
              <label for="team_size" class="block text-sm font-medium text-gray-700 mb-1">Team Size</label>
              <select id="team_size" name="team_size" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option>2 players</option>
                <option>3 players</option>
                <option>4 players</option>
                <option>5 players</option>
              </select>
            </div>

            <div>
              <label for="rank" class="block text-sm font-medium text-gray-700 mb-1">Required Rank</label>
              <select id="rank" name="rank" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option>Any Rank</option>
                <option>Silver</option>
                <option>Gold Nova</option>
                <option>Master Guardian</option>
                <option>Distinguished Master Guardian</option>
                <option>Legendary Eagle</option>
                <option>Supreme</option>
                <option>Global Elite</option>
              </select>
            </div>
            
            <div>
              <label for="region" class="block text-sm font-medium text-gray-700 mb-1">Region</label>
              <select id="region" name="region" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option>North America</option>
                <option>Europe</option>
                <option>Asia</option>
                <option>Oceania</option>
                <option>South America</option>
              </select>
            </div>

            <div>
              <label for="playstyle" class="block text-sm font-medium text-gray-700 mb-1">Playstyle</label>
              <select id="playstyle" name="playstyle" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option>Casual</option>
                <option>Competitive</option>
                <option>Semi-Pro</option>
              </select>
            </div>

            <div>
              <label for="schedule" class="block text-sm font-medium text-gray-700 mb-1">Schedule/Availability</label>
              <select id="schedule" name="schedule" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option>Weekdays</option>
                <option>Weekends</option>
                <option>Evenings</option>
                <option>Flexible</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
              <textarea id="description" name="description" rows="4" placeholder="Describe your team, what roles you're looking for, etc." class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md"></textarea>
            </div>
          </div>

          <div class="flex justify-end">
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              Create Listing
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div> 