<div class="relative min-h-screen bg-gray-50">
  <main class="py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <!-- Header with navigation -->
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
          <div class="flex items-center">
            <%= case @lobby.lobby_type do %>
              <% "Competitive" -> %><div class="h-4 w-4 bg-green-400 rounded-full mr-3"></div>
              <% "Casual" -> %><div class="h-4 w-4 bg-blue-400 rounded-full mr-3"></div>
              <% "Practice" -> %><div class="h-4 w-4 bg-purple-400 rounded-full mr-3"></div>
              <% "Tournament" -> %><div class="h-4 w-4 bg-yellow-400 rounded-full mr-3"></div>
              <% _ -> %><div class="h-4 w-4 bg-gray-400 rounded-full mr-3"></div>
            <% end %>
            <h1 class="text-xl font-semibold text-gray-900">Team: <%= @lobby.title %></h1>
          </div>
          <.link navigate={~p"/teamfinder"} class="text-indigo-600 hover:text-indigo-800">Back to Teams</.link>
        </div>
        
        <!-- Details & Players -->
        <div class="p-6 space-y-8">
          <div class="flex flex-col md:flex-row gap-8">
            <!-- Lobby Info -->
            <div class="md:w-1/2 space-y-6">
              <div>
                <h2 class="text-lg font-medium text-gray-900 mb-2">Details</h2>
                <div class="bg-gray-50 rounded-lg p-4 space-y-2">
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Type:</span>
                    <span class="text-sm text-right">
                      <%= case @lobby.lobby_type do %>
                        <% "Competitive" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Competitive
                          </span>
                        <% "Casual" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            Casual
                          </span>
                        <% "Practice" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                            Practice
                          </span>
                        <% "Tournament" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                            Tournament
                          </span>
                        <% _ -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            <%= @lobby.lobby_type %>
                          </span>
                      <% end %>
                    </span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Region:</span>
                    <span class="text-sm text-gray-900"><%= @lobby.region %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Rank Required:</span>
                    <span class="text-sm text-gray-900"><%= @lobby.rank_required %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Team Size:</span>
                    <span class="text-sm text-gray-900"><%= @lobby.team_size %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Players:</span>
                    <span class="text-sm text-gray-900"><%= length(@lobby.players) %>/<%= @lobby.team_size %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-sm font-medium text-gray-500">Created:</span>
                    <span class="text-sm text-gray-900"><%= relative_time(@lobby.created_at) %></span>
                  </div>
                </div>
              </div>

              <div>
                <h2 class="text-lg font-medium text-gray-900 mb-2">Description</h2>
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-sm text-gray-600"><%= @lobby.description %></p>
                </div>
              </div>
              
              <!-- Online Players Panel -->
              <div>
                <h2 class="text-lg font-medium text-gray-900 mb-2">Online Players (<%= @online_count %>)</h2>
                <div class="bg-gray-50 rounded-lg p-4">
                  <div class="max-h-48 overflow-y-auto">
                    <%= if Enum.empty?(@online_users) do %>
                      <p class="text-sm text-gray-500">No players online</p>
                    <% else %>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <%= for {user_id, presence_data} <- @online_users do %>
                          <% metas = List.first(presence_data.metas) %>
                          <div class="flex items-center p-2 rounded bg-white border border-gray-100">
                            <div class="relative">
                              <div class="h-8 w-8 rounded-full overflow-hidden mr-2">
                                <img 
                                  src={"https://cdn.discordapp.com/avatars/#{metas.discord_id}/#{metas.avatar}.png"} 
                                  alt={metas.username} 
                                  class="w-full h-full object-cover"
                                  onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{metas.username}&background=random';"}
                                />
                              </div>
                              <span class="absolute bottom-0 right-0 block h-2 w-2 rounded-full bg-green-400 ring-1 ring-white"></span>
                            </div>
                            <div class="ml-2">
                              <p class="text-sm font-medium text-gray-900"><%= metas.username %></p>
                              <p class="text-xs text-gray-500">
                                <%= if Map.has_key?(metas, :page) do %>
                                  <%= metas.page %>
                                <% else %>
                                  Online
                                <% end %>
                              </p>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Players -->
            <div class="md:w-1/2 space-y-6">
              <div>
                <h2 class="text-lg font-medium text-gray-900 mb-2">Players</h2>
                <div class="bg-gray-50 rounded-lg p-4">
                  
                  <!-- Host card - always fixed at the top -->
                  <div id="host-card" class="host-card mb-3">
                    <%= for player <- @lobby.players do %>
                      <%= if player["id"] == @lobby.leader_id do %>
                        <div class="player-card flex items-center justify-between rounded-md transition-all duration-150 border-l-4 border-yellow-500 pl-2 bg-yellow-50 p-2">
                          <div class="flex items-center">
                            <div class="h-8 w-8 rounded-full overflow-hidden mr-2">
                              <img 
                                src={"https://cdn.discordapp.com/avatars/#{player["discord_id"]}/#{player["avatar"]}.png"} 
                                alt={player["username"]} 
                                class="w-full h-full object-cover"
                                onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{player["username"]}&background=random';"}
                              />
                            </div>
                            <div class="flex flex-col">
                              <span class="text-sm font-medium"><%= player["username"] %></span>
                              <div class="flex items-center space-x-2">
                                <span class="text-xs text-gray-500">Joined: <%= get_player_join_time(player) %></span>
                                <%= if player_is_connected?(player) do %>
                                  <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Online
                                  </span>
                                <% else %>
                                  <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                    </svg>
                                    Offline
                                  </span>
                                  <% disconnect_time = get_disconnect_remaining_time(player) %>
                                  <%= if disconnect_time do %>
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                      <%= disconnect_time %>
                                    </span>
                                  <% end %>
                                <% end %>
                              </div>
                            </div>
                          </div>
                          <div class="flex items-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                              Leader
                            </span>
                          </div>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  
                  <!-- Visual divider and succession message -->
                  <div class="flex items-center py-2">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink mx-2 text-xs text-gray-500">Succession Order</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                  </div>
                  
                  <!-- Sortable player list - all players except the host -->
                  <div id="player-list-container" class="mt-2">
                    <ul id="sortable-player-list" class="space-y-3" phx-hook="SortablePlayers" data-leader-id={@lobby.leader_id}>
                      <%= for player <- @lobby.players do %>
                        <%= if player["id"] != @lobby.leader_id do %>
                          <% is_next_in_line = player_is_connected?(player) && Map.get(player, "position", 999) == 1 %>
                          <% player_style = if is_next_in_line, do: "border-l-4 border-blue-300 pl-2 bg-blue-50", else: "" %>
                          <% connection_style = if !player_is_connected?(player), do: "bg-amber-50 border border-amber-200 p-2", else: "bg-white hover:bg-gray-50 p-2" %>
                          <li class={"player-card flex items-center justify-between rounded-md transition-all duration-150 #{connection_style} #{player_style}"} 
                              data-id={player["id"]} 
                              data-position={Map.get(player, "position", 999)}>
                            <div class="flex items-center">
                              <%= if player_is_leader?(@current_user, @lobby) do %>
                                <div class="mr-2 text-gray-400 drag-handle relative" 
                                    x-data="tooltip" 
                                    data-tooltip="Drag to reorder succession"
                                    @mouseenter="mouseEnter" 
                                    @mouseleave="mouseLeave">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                  </svg>
                                  <div x-show="show" x-cloak 
                                      class="tooltip-content absolute left-0 top-full mt-1 w-40 bg-black text-white text-xs rounded py-1 px-2" 
                                      x-text="text" style="display: none;">
                                  </div>
                                </div>
                              <% end %>
                              <div class="h-8 w-8 rounded-full overflow-hidden mr-2">
                                <img 
                                  src={"https://cdn.discordapp.com/avatars/#{player["discord_id"]}/#{player["avatar"]}.png"} 
                                  alt={player["username"]} 
                                  class="w-full h-full object-cover"
                                  onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{player["username"]}&background=random';"}
                                />
                              </div>
                              <div class="flex flex-col">
                                <span class="text-sm font-medium"><%= player["username"] %></span>
                                <div class="flex items-center space-x-2">
                                  <span class="text-xs text-gray-500">Joined: <%= get_player_join_time(player) %></span>
                                  <%= if player_is_connected?(player) do %>
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                      Online
                                    </span>
                                  <% else %>
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                      </svg>
                                      Offline
                                    </span>
                                    <% disconnect_time = get_disconnect_remaining_time(player) %>
                                    <%= if disconnect_time do %>
                                      <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <%= disconnect_time %>
                                      </span>
                                    <% end %>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                            <div class="flex items-center space-x-2">
                              <%= if @current_user && player["id"] != @lobby.leader_id && Map.get(player, "position", 999) == 1 do %>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                  Next In Line
                                </span>
                              <% end %>
                              <%= if player_is_leader?(@current_user, @lobby) do %>
                                <div class="relative" x-data="{ open: false }">
                                  <button @click="open = !open" type="button" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                                    <span class="sr-only">Options</span>
                                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                    </svg>
                                  </button>
                                  <div x-show="open" @click.away="open = false" class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100 focus:outline-none z-10" role="menu" aria-orientation="vertical" aria-labelledby="options-menu">
                                    <div class="py-1" role="none">
                                      <button phx-click="transfer-leadership" phx-value-id={@lobby.id} phx-value-player_id={player["id"]} class="text-blue-700 w-full text-left block px-4 py-2 text-sm hover:bg-gray-100" role="menuitem">
                                        Transfer Leadership
                                      </button>
                                      <button phx-click="kick-player" phx-value-id={@lobby.id} phx-value-player_id={player["id"]} phx-value-should_block="false" class="text-gray-700 w-full text-left block px-4 py-2 text-sm hover:bg-gray-100" role="menuitem">
                                        Kick Player
                                      </button>
                                      <button phx-click="kick-player" phx-value-id={@lobby.id} phx-value-player_id={player["id"]} phx-value-should_block="true" class="text-red-600 w-full text-left block px-4 py-2 text-sm hover:bg-gray-100" role="menuitem">
                                        Kick & Ban Player
                                      </button>
                                    </div>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                          </li>
                        <% end %>
                      <% end %>
                    </ul>
                  </div>
                  
                  <%= if player_is_leader?(@current_user, @lobby) do %>
                    <div class="mt-3 text-xs text-gray-500">
                      <p>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5 10a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1z" clip-rule="evenodd" />
                          <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v8a1 1 0 11-2 0V6a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Drag and drop players to reorder them. The player directly below you will be the next host if you disconnect.
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="pt-4">
                <%= if player_in_lobby?(@current_user, @lobby) do %>
                  <button phx-click="leave-lobby" phx-value-id={@lobby.id} type="button" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    Leave Team
                  </button>
                <% else %>
                  <%= if length(@lobby.players) < String.to_integer(@lobby.team_size) do %>
                    <button phx-click="join-lobby" phx-value-id={@lobby.id} type="button" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                      Join Team
                    </button>
                  <% else %>
                    <button disabled type="button" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-400 cursor-not-allowed">
                      Team Full
                    </button>
                  <% end %>
                <% end %>
              </div>
              
              <%= if player_is_leader?(@current_user, @lobby) do %>
                <div class="pt-2">
                  <button phx-click="delete-team" phx-value-id={@lobby.id} type="button" class="w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Close Team
                  </button>
                </div>
              <% end %>
            </div>

            <!-- Team Chat -->
            <%= if player_in_lobby?(@current_user, @lobby) do %>
              <div class="md:w-1/2 space-y-6">
                <div>
                  <div class="flex items-center justify-between">
                    <h2 class="text-lg font-medium text-gray-900 mb-2">Team Chat</h2>
                    <%= if player_is_leader?(@current_user, @lobby) do %>
                      <button phx-click="toggle_host_only_chat" class={"inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md shadow-sm text-white #{if @lobby.chat_host_only, do: "bg-red-500 hover:bg-red-600", else: "bg-indigo-500 hover:bg-indigo-600"} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"}>
                        <%= if @lobby.chat_host_only do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                          </svg>
                          Host Only
                        <% else %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
                          </svg>
                          Everyone
                        <% end %>
                      </button>
                    <% end %>
                  </div>
                  
                  <!-- Chat Messages Area -->
                  <div class="bg-gray-50 rounded-lg p-3">
                    <div id="chat-messages" phx-hook="ChatScroll" class="h-64 overflow-y-auto mb-3 p-2 bg-white border border-gray-200 rounded-md" phx-update="replace">
                      <%= if !@lobby.chat_messages || Enum.empty?(@lobby.chat_messages) do %>
                        <div id="empty-chat-message" class="flex items-center justify-center h-full">
                          <p class="text-sm text-gray-500">No messages yet</p>
                        </div>
                      <% else %>
                        <!-- Messages are stored newest first, so we need to reverse -->
                        <%= for message <- Enum.reverse(@lobby.chat_messages) do %>
                          <div id={"chat-message-#{message.id}"} class={"chat-message mb-2 p-2 rounded-lg hover:bg-gray-50 group relative #{if message[:deleted], do: 'deleted-message bg-gray-100'}"}>
                            <div class="flex">
                              <div class="h-8 w-8 rounded-full overflow-hidden mr-2 flex-shrink-0">
                                <img 
                                  src={"https://cdn.discordapp.com/avatars/#{message.discord_id}/#{message.avatar}.png"} 
                                  alt={message.username} 
                                  class="w-full h-full object-cover"
                                  onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{message.username}&background=random';"}
                                />
                              </div>
                              <div class="flex flex-col w-full">
                                <div class="flex justify-between items-center">
                                  <span class="text-sm font-medium text-gray-900">
                                    <%= message.username %>
                                    <%= if message.user_id == @lobby.leader_id do %>
                                      <span class="ml-1 text-xs text-yellow-600">(Host)</span>
                                    <% end %>
                                  </span>
                                  <span class="text-xs text-gray-500">
                                    <%= relative_time(message.timestamp) %>
                                  </span>
                                </div>
                                <p class={"text-sm #{if message[:deleted], do: 'text-gray-500 italic', else: 'text-gray-700'}"}><%= message.content %></p>
                              </div>
                            </div>
                            
                            <!-- Delete button for host - only show for non-deleted messages -->
                            <%= if player_is_leader?(@current_user, @lobby) && !message[:deleted] do %>
                              <div class="absolute top-2 right-2 hidden group-hover:block">
                                <button phx-click="delete_chat_message" phx-value-message_id={message.id} class="text-red-600 hover:text-red-800">
                                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                  </svg>
                                </button>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                    
                    <!-- Chat Input Form -->
                    <div class="relative">
                      <%= if @lobby.chat_host_only && @current_user && @current_user.id != @lobby.leader_id do %>
                        <div class="flex items-center justify-center py-2 px-4 bg-red-50 border border-red-200 text-red-600 rounded-md">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                          </svg>
                          <span class="text-sm">Host-only mode is enabled</span>
                        </div>
                      <% else %>
                        <form phx-submit="send_chat_message" class="flex">
                          <input 
                            type="text" 
                            name="message" 
                            placeholder="Type your message..." 
                            maxlength="500"
                            class="flex-grow border border-gray-300 rounded-l-md shadow-sm py-2 px-3 text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500" 
                            required
                          />
                          <button 
                            type="submit"
                            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-r-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                          </button>
                        </form>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="md:w-1/2 space-y-6">
                <div>
                  <h2 class="text-lg font-medium text-gray-900 mb-2">Team Chat</h2>
                  <div class="bg-gray-50 rounded-lg p-6">
                    <div class="flex flex-col items-center justify-center text-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                      </svg>
                      <p class="text-gray-600 mb-2">You need to be a member of this team to view the chat</p>
                      <%= if @current_user do %>
                        <button phx-click="join-lobby" phx-value-id={@lobby.id} class="mt-4 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                          Join Team to Chat
                        </button>
                      <% else %>
                        <p class="text-sm text-gray-500 mt-2">Log in to join this team</p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Team Conflict Modal -->
  <%= if @show_team_conflict_modal do %>
    <div class="fixed inset-0 z-10 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        
        <div class="relative inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
          <div>
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100">
              <svg class="h-6 w-6 text-yellow-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="mt-3 text-center sm:mt-5">
              <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                <%= if @is_creating_lobby do %>
                  You're Already in a Team
                <% else %>
                  Team Conflict
                <% end %>
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500">
                  <%= if @is_creating_lobby do %>
                    You are already a member of the team "<%= @current_lobby.title %>". You cannot create a new team while being a member of another team. Do you want to leave your current team to create a new one?
                  <% else %>
                    You are already a member of the team "<%= @current_lobby.title %>". You cannot join multiple teams at the same time. Do you want to leave your current team to join this one?
                  <% end %>
                </p>
              </div>
            </div>
          </div>
          <div class="mt-5 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-3 sm:grid-flow-row-dense">
            <%= if @is_creating_lobby do %>
              <button phx-click="confirm-create-leave" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:col-start-2 sm:text-sm">
                Leave & Create New Team
              </button>
            <% else %>
              <button phx-click="confirm-leave-join" phx-value-lobby_id={@joining_lobby_id} type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:col-start-2 sm:text-sm">
                Leave & Join New Team
              </button>
            <% end %>
            <button phx-click="cancel-leave-join" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:col-start-1 sm:text-sm">
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div> 