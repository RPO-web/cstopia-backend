<div class="relative min-h-screen bg-gray-50">
  <main class="py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header with create button and filters -->
      <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <h1 class="text-2xl font-semibold text-gray-900">Active Teams</h1>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <form phx-change="filter-lobbies" class="flex flex-col sm:flex-row gap-4 w-full">
            <div class="flex space-x-2 w-full sm:w-auto">
              <select name="region" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option selected={@filter_region == "All Regions"}>All Regions</option>
                <option selected={@filter_region == "North America"}>North America</option>
                <option selected={@filter_region == "Europe"}>Europe</option>
                <option selected={@filter_region == "Asia"}>Asia</option>
                <option selected={@filter_region == "Oceania"}>Oceania</option>
                <option selected={@filter_region == "South America"}>South America</option>
              </select>
              
              <select name="rank" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option selected={@filter_rank == "All Ranks"}>All Ranks</option>
                <option selected={@filter_rank == "Silver"}>Silver</option>
                <option selected={@filter_rank == "Gold Nova"}>Gold Nova</option>
                <option selected={@filter_rank == "Master Guardian"}>Master Guardian</option>
                <option selected={@filter_rank == "Legendary Eagle+"}>Legendary Eagle+</option>
              </select>

              <select name="type" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option selected={@filter_type == "All Types"}>All Types</option>
                <option selected={@filter_type == "Competitive"}>Competitive</option>
                <option selected={@filter_type == "Casual"}>Casual</option>
                <option selected={@filter_type == "Practice"}>Practice</option>
                <option selected={@filter_type == "Tournament"}>Tournament</option>
              </select>
            </div>
          </form>
          
          <% user_lobbies = if @current_user, do: LobbyManager.find_user_lobbies(@current_user.id), else: [] %>
          <% in_lobby = !Enum.empty?(user_lobbies) %>
          <% current_lobby = if in_lobby, do: List.first(user_lobbies), else: nil %>
          
          <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <%= if in_lobby do %>
              <button disabled class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-gray-400 cursor-not-allowed w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Create Team
              </button>
              
              <button phx-click="leave-lobby" phx-value-id={current_lobby.id} class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Leave Team
              </button>
            <% else %>
              <.link navigate={~p"/teamfinder/create"} class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Create Team
              </.link>
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Main content - Teams listing in Discord style -->
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3">
          <!-- Left sidebar - Categories -->
          <div class="bg-gray-800 lg:block">
            <div class="p-4 border-b border-gray-700">
              <h2 class="text-lg font-medium text-white">Team Types</h2>
            </div>
            <div class="py-2">
              <button phx-click="select-lobby-type" phx-value-type="Competitive" class={"w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left #{if @selected_lobby_type == "Competitive", do: "bg-gray-700"}"}>
                <span class="h-2 w-2 bg-green-400 rounded-full mr-2"></span>
                <span>Competitive (<%= Enum.count(@lobbies, fn l -> is_map(l) && Map.has_key?(l, :lobby_type) && l.lobby_type == "Competitive" end) %>)</span>
              </button>
              <button phx-click="select-lobby-type" phx-value-type="Casual" class={"w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left #{if @selected_lobby_type == "Casual", do: "bg-gray-700"}"}>
                <span class="h-2 w-2 bg-blue-400 rounded-full mr-2"></span>
                <span>Casual (<%= Enum.count(@lobbies, fn l -> is_map(l) && Map.has_key?(l, :lobby_type) && l.lobby_type == "Casual" end) %>)</span>
              </button>
              <button phx-click="select-lobby-type" phx-value-type="Practice" class={"w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left #{if @selected_lobby_type == "Practice", do: "bg-gray-700"}"}>
                <span class="h-2 w-2 bg-purple-400 rounded-full mr-2"></span>
                <span>Practice/Scrims (<%= Enum.count(@lobbies, fn l -> is_map(l) && Map.has_key?(l, :lobby_type) && l.lobby_type == "Practice" end) %>)</span>
              </button>
              <button phx-click="select-lobby-type" phx-value-type="Tournament" class={"w-full flex items-center text-gray-300 hover:bg-gray-700 px-4 py-2 text-left #{if @selected_lobby_type == "Tournament", do: "bg-gray-700"}"}>
                <span class="h-2 w-2 bg-yellow-400 rounded-full mr-2"></span>
                <span>Tournament (<%= Enum.count(@lobbies, fn l -> is_map(l) && Map.has_key?(l, :lobby_type) && l.lobby_type == "Tournament" end) %>)</span>
              </button>
            </div>

            <!-- Online Players Panel -->
            <div class="mt-6 px-4">
              <div class="flex items-center justify-between">
                <h3 class="text-md font-medium text-white">Online Players</h3>
                <span class="bg-green-500 text-white text-xs font-medium px-2 py-1 rounded-full"><%= @online_count %></span>
              </div>
              <div class="mt-2 space-y-1 max-h-48 overflow-y-auto">
                <%= if Enum.empty?(@online_users) do %>
                  <p class="text-gray-500 text-sm">No players online</p>
                <% else %>
                  <%= for {user_id, presence_data} <- @online_users do %>
                    <% metas = List.first(presence_data.metas) %>
                    <div class="flex items-center py-2 px-2 rounded hover:bg-gray-700">
                      <div class="relative">
                        <div class="h-8 w-8 rounded-full overflow-hidden mr-2 bg-gray-600">
                          <img 
                            src={"https://cdn.discordapp.com/avatars/#{metas.discord_id}/#{metas.avatar}.png"} 
                            alt={metas.username} 
                            class="w-full h-full object-cover"
                            onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{metas.username}&background=random';"}
                          />
                        </div>
                        <span class="absolute bottom-0 right-0 block h-2 w-2 rounded-full bg-green-400 ring-1 ring-white"></span>
                      </div>
                      <div class="ml-2">
                        <p class="text-sm font-medium text-white"><%= metas.username %></p>
                        <p class="text-xs text-gray-400">
                          <%= if Map.has_key?(metas, :page) do %>
                            <%= metas.page %>
                          <% else %>
                            Online
                          <% end %>
                        </p>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- Middle - Lobby listing -->
          <div class="border-r border-gray-200 lg:col-span-2">
            <div class="p-4 border-b border-gray-200 bg-gray-50">
              <div class="relative">
                <input type="text" placeholder="Search lobbies..." class="block w-full rounded-md border-gray-300 pr-10 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Lobby Cards -->
            <div class="p-4 space-y-4 max-h-[calc(100vh-12rem)] overflow-y-auto">
              <%= if Enum.empty?(@lobbies) do %>
                <div class="text-center py-12">
                  <p class="text-gray-500">No active lobbies found</p>
                  <p class="text-gray-500 mt-1">Create one to get started!</p>
                </div>
              <% else %>
                <%= for lobby <- @lobbies do %>
                  <%= if is_map(lobby) && Map.has_key?(lobby, :id) && Map.has_key?(lobby, :title) && Map.has_key?(lobby, :lobby_type) do %>
                  <div class="border border-gray-200 rounded-lg hover:border-indigo-500 transition-colors duration-150">
                    <div class="flex p-4 items-center justify-between border-b border-gray-200">
                      <div class="flex items-center">
                        <%= case lobby.lobby_type do %>
                          <% "Competitive" -> %><span class="h-3 w-3 bg-green-400 rounded-full mr-3"></span>
                          <% "Casual" -> %><span class="h-3 w-3 bg-blue-400 rounded-full mr-3"></span>
                          <% "Practice" -> %><span class="h-3 w-3 bg-purple-400 rounded-full mr-3"></span>
                          <% "Tournament" -> %><span class="h-3 w-3 bg-yellow-400 rounded-full mr-3"></span>
                          <% _ -> %><span class="h-3 w-3 bg-gray-400 rounded-full mr-3"></span>
                        <% end %>
                        <h3 class="text-lg font-medium text-gray-900"><%= lobby.title %></h3>
                      </div>
                      <%= case lobby.lobby_type do %>
                        <% "Competitive" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Competitive
                          </span>
                        <% "Casual" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            Casual
                          </span>
                        <% "Practice" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                            Practice
                          </span>
                        <% "Tournament" -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                            Tournament
                          </span>
                        <% _ -> %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                            <%= lobby.lobby_type %>
                          </span>
                      <% end %>
                    </div>
                    
                    <div class="p-4">
                      <div class="flex justify-between mb-3">
                        <div class="text-sm text-gray-500">
                          <span class="font-medium text-gray-900">Region:</span> <%= Map.get(lobby, :region, "Unknown") %>
                        </div>
                        <div class="text-sm text-gray-500">
                          <span class="font-medium text-gray-900">Rank:</span> <%= Map.get(lobby, :rank_required, "Any") %>
                        </div>
                      </div>
                      
                      <div class="border-t border-gray-200 pt-3 pb-1">
                        <h4 class="text-sm font-medium text-gray-900 mb-2">Current Players (<%= if Map.has_key?(lobby, :players) && is_list(lobby.players), do: length(lobby.players), else: 0 %>/<%= Map.get(lobby, :team_size, "?") %>):</h4>
                        <div class="flex flex-wrap gap-2">
                          <%= if Map.has_key?(lobby, :players) && is_list(lobby.players) do %>
                            <%= for player <- lobby.players do %>
                              <%= if is_map(player) && Map.has_key?(player, "username") do %>
                              <div class="flex items-center bg-gray-100 rounded-full pl-1 pr-3 py-1">
                                <div class="h-6 w-6 rounded-full overflow-hidden mr-2">
                                  <img 
                                    src={"https://cdn.discordapp.com/avatars/#{player["discord_id"]}/#{player["avatar"]}.png"} 
                                    alt={player["username"]} 
                                    class="w-full h-full object-cover"
                                    onerror={"this.onerror=null; this.src='https://ui-avatars.com/api/?name=#{player["username"]}&background=random';"}
                                  />
                                </div>
                                <span class="text-sm"><%= player["username"] %></span>
                              </div>
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                    
                    <div class="bg-gray-50 px-4 py-3 rounded-b-lg flex justify-between items-center">
                      <span class="text-xs text-gray-500">
                        Created <%= if Map.has_key?(lobby, :created_at), do: relative_time(lobby.created_at), else: "recently" %>
                        <% leader = if Map.has_key?(lobby, :leader_id) && Map.has_key?(lobby, :players), do: get_player_by_id(lobby, lobby.leader_id), else: nil %>
                        <%= if leader && !player_is_connected?(leader) do %>
                          · <span class="text-amber-600">Host Offline</span>
                          <% disconnect_time = get_disconnect_remaining_time(leader) %>
                          <%= if disconnect_time do %>
                            <span class="text-red-600"> (<%= disconnect_time %>)</span>
                          <% end %>
                        <% end %>
                      </span>
                      <.link navigate={~p"/teamfinder/#{lobby.id}"} class={"inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white #{if @current_user && player_in_lobby?(@current_user, lobby), do: "bg-green-600 hover:bg-green-700", else: "bg-indigo-600 hover:bg-indigo-700"} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"}>
                        <%= if @current_user && player_in_lobby?(@current_user, lobby) do %>
                          View Your Team
                        <% else %>
                          View Details
                        <% end %>
                      </.link>
                    </div>
                  </div>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Team Conflict Modal -->
  <%= if @show_team_conflict_modal do %>
    <div class="fixed inset-0 z-10 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        
        <div class="relative inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
          <div>
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100">
              <svg class="h-6 w-6 text-yellow-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="mt-3 text-center sm:mt-5">
              <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                <%= if @is_creating_lobby do %>
                  You're Already in a Team
                <% else %>
                  Team Conflict
                <% end %>
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500">
                  <%= if @is_creating_lobby do %>
                    You are already a member of the team "<%= @current_lobby.title %>". You cannot create a new team while being a member of another team. Do you want to leave your current team to create a new one?
                  <% else %>
                    You are already a member of the team "<%= @current_lobby.title %>". You cannot join multiple teams at the same time. Do you want to leave your current team to join this one?
                  <% end %>
                </p>
              </div>
            </div>
          </div>
          <div class="mt-5 sm:mt-6 sm:grid sm:grid-cols-2 sm:gap-3 sm:grid-flow-row-dense">
            <%= if @is_creating_lobby do %>
              <button phx-click="confirm-create-leave" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:col-start-2 sm:text-sm">
                Leave & Create New Team
              </button>
            <% else %>
              <button phx-click="confirm-leave-join" phx-value-lobby_id={@joining_lobby_id} type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:col-start-2 sm:text-sm">
                Leave & Join New Team
              </button>
            <% end %>
            <button phx-click="cancel-leave-join" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:col-start-1 sm:text-sm">
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div> 